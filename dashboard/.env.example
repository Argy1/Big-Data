# Salin ke .env lalu sesuaikan bila perlu.

# --- api (FastAPI) ---
DATA_DIR=./data
REDIS_URL=redis://localhost:6379/0
REPLAY_START=2017-06-07T16:45:00
TICK_SECONDS=5
CORS_ORIGINS=http://localhost:3000

# --- worker (speed layer) ---
# Kosongkan untuk pilih otomatis (cuda:0 bila tersedia, selain itu cpu)
WORKER_DEVICE=

# --- web (Next.js) ---
# Dipakai browser untuk memanggil API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
